# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Datasets -- personal photos / large image sets don't belong in git
data/train/**
data/val/**
data/test/**
!data/**/.gitkeep

# Pretrained backbone cache -- large binary, regenerated by
# scripts/fetch_pretrained_backbone.py, not needed outside the sandbox
# this project was originally built in.
checkpoints/pretrained/

# NOTE: checkpoints/best_model.pth is intentionally NOT ignored.
# Streamlit Community Cloud only runs app.py -- it never runs train.py --
# so the trained weights have to already be sitting in the repo, or the
# deployed app has nothing to load.

# Generated outputs (confusion matrices, Grad-CAM images, etc.)
outputs/*.png
outputs/*.jpg
!outputs/.gitkeep

# OS / editor cruft
.DS_Store
.vscode/
.idea/